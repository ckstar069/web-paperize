{
  "manifest_version": 3,
  "name": "web-paperize",
  "version": "0.2.1",
  "description": "Save the current page as a vector PDF rendered by Chrome itself. Local only, no telemetry.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "offscreen",
    "debugger",
    "contextMenus"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Save as PDF"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/adapter/chatgpt/materialize.js",
        "src/adapter/chatgpt/markdown.js",
        "src/adapter/chatgpt/acquire.js",
        "src/adapter/chatgpt/normalize.js"
      ],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]
    }
  ]
}
